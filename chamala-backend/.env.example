# Copie para .env (o .env não vai para o git) e preencha.
# Supabase: Project Settings → Database → Connection string (Session pooler, JDBC).
DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<id-do-projeto>
DB_PASSWORD=<senha-do-banco>

# Porta da API
PORT=8085

# true só num banco vazio (ex.: PostGIS local do docker-compose) para criar as tabelas.
FLYWAY_ENABLED=false
